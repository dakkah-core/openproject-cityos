# CityOS HELM Plugin Dependencies
# 
# CityOS plugins are Rails Engines loaded as Bundler path gems.
# Omniauth gems are NOT declared here — they are already bundled
# in OpenProject's upstream Gemfile. Declaring them again with
# version constraints causes duplicate-gem conflicts.

gem 'openproject-cityos-foundation', path: 'modules/cityos-foundation'
gem 'openproject-cityos-identity',  path: 'modules/cityos-identity'
gem 'openproject-cityos-governance', path: 'modules/cityos-governance'
gem 'openproject-cityos-portfolio', path: 'modules/cityos-portfolio'
gem 'openproject-cityos-strategy',  path: 'modules/cityos-strategy'
