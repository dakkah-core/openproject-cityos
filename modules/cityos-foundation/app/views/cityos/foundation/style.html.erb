<div class="op-container">
  <div class="toolbar">
    <h2>CityOS Style</h2>
  </div>
  <div class="wiki-content">
    <div class="generic-table--container">
      <div class="attributes-group">
        <p><strong>Status:</strong> <%= @status.to_s.humanize %></p>
        <p><strong>Scope:</strong> Admin-owned CityOS style governance workspace</p>
      </div>

      <div class="generic-table--results-container">
        <table class="generic-table">
          <thead>
            <tr>
              <th>Replacement Control</th>
            </tr>
          </thead>
          <tbody>
            <% @style_controls.each do |control| %>
              <tr>
                <td><%= control %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
