<div class="op-container">
  <div class="toolbar">
    <h2>CityOS Revit Add-in</h2>
  </div>
  <div class="wiki-content">
    <div class="generic-table--container">
      <div class="attributes-group">
        <p><strong>Status:</strong> <%= @revit_status.to_s.humanize %></p>
        <p><strong>Scope:</strong> CityOS-owned BIM and Revit rollout workspace</p>
      </div>

      <div class="generic-table--results-container">
        <table class="generic-table">
          <thead>
            <tr>
              <th>Replacement Capability</th>
            </tr>
          </thead>
          <tbody>
            <% @revit_capabilities.each do |capability| %>
              <tr>
                <td><%= capability %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
