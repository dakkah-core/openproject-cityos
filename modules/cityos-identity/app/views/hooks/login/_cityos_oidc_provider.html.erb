<%# CityOS SSO login button — provider-neutral, CityOS-branded %>
<% if OpenProject::CityosIdentity::OidcStrategy.configured? %>
  <%= link_to "/auth/cityos_oidc",
      class: "button auth-provider-cityos",
      data: { turbo: false } do %>
    <span class="auth-provider-button--logo">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <path d="M7 12h10M12 7v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>
      </svg>
    </span>
    <span class="button--text">
      <%= I18n.t(:label_sign_in_with_cityos, default: "Sign in with CityOS") %>
    </span>
  <% end %>
<% end %>
