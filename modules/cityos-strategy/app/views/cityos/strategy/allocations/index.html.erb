<% content_for :header_tags do %>
  <meta name="turbo-visit-control" content="reload">
<% end %>

<div class="op-container">
  <div class="toolbar-container">
    <div class="toolbar">
      <div class="title-container">
        <h2>Resource Allocations</h2>
      </div>
      <% if respond_to?(:action_name) && respond_to?(:new_polymorphic_path) %>
        <ul class="toolbar-items">
          
        </ul>
      <% end %>
    </div>
  </div>

  <div class="wiki-content">

    <% if @scenario %>
      <h3>Scenario: <%= @scenario.name %></h3>

      <% if @allocations && @allocations.any? %>
        <div class="op-widget-box">
          <div class="op-widget-box--header"><h3>By Dimension</h3></div>
          <table class="generic-table">
            <thead><tr><th>Dimension</th><th>Total Amount</th><th>Initiatives</th></tr></thead>
            <tbody>
              <% @allocations.each do |dim, allocs| %>
                <tr>
                  <td><strong><%= dim.humanize %></strong></td>
                  <td><%= @totals[dim.to_s] || 0 %> <%= (allocs.first&.unit rescue 'SAR') || 'SAR' %></td>
                  <td><%= allocs.count %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @funding_distribution && @funding_distribution.any? %>
          <div class="op-widget-box">
            <div class="op-widget-box--header"><h3>Funding Distribution</h3></div>
            <table class="generic-table">
              <thead><tr><th>Initiative</th><th>Amount</th><th>Unit</th></tr></thead>
              <tbody>
                <% @funding_distribution.each do |a| %>
                  <tr>
                    <td><%= a.initiative&.title || '—' %></td>
                    <td><%= a.amount %></td>
                    <td><%= a.unit %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      <% else %>
        <div class="nodata"><p>No allocations defined for this scenario.</p></div>
      <% end %>
    <% else %>
      <div class="nodata"><p>Select a scenario to view allocations.</p></div>
    <% end %>

  </div>
</div>