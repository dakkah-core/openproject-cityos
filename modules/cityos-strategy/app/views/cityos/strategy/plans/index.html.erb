<%% content_for :header_tags do %>
  <meta name="turbo-visit-control" content="reload">
<%% end %>

<div class="op-container">
  <div class="toolbar-container">
    <div class="toolbar">
      <div class="title-container">
        <h2>Strategic Plans</h2>
      </div>
      <%% if respond_to?(:action_name) && respond_to?(:new_polymorphic_path) %>
        <ul class="toolbar-items">
          <%%= link_to t(:label_plan_new), new_plan_path, class: 'button -primary' %>
        </ul>
      <%% end %>
    </div>
  </div>

  <div class="wiki-content">

    <%% if @plans && @plans.any? %>
      <div class="op-widget-box">
        <div class="op-widget-box--header"><h3>Plans (<%%= @plans.count %>)</h3></div>
        <table class="generic-table">
          <thead>
            <tr><th>ID</th><th>Title</th><th>Type</th><th>Status</th><th>Version</th><th>Effective From</th><th>Effective To</th><th>Owner</th></tr>
          </thead>
          <tbody>
            <%% @plans.each do |plan| %>
              <tr>
                <td><%%= plan.id %></td>
                <td><%%= link_to plan.title, plan_path(plan) %></td>
                <td><%%= plan.plan_type&.humanize || '—' %></td>
                <td><%%= content_tag :span, plan.status&.humanize, class: "badge badge--#{plan.status}" %></td>
                <td>v<%%= plan.version %></td>
                <td><%%= plan.effective_from&.strftime('%Y-%m-%d') || '—' %></td>
                <td><%%= plan.effective_to&.strftime('%Y-%m-%d') || '—' %></td>
                <td><%%= plan.owner&.name || '—' %></td>
              </tr>
            <%% end %>
          </tbody>
        </table>
      </div>
    <%% else %>
      <div class="nodata"><p>No strategic plans created.</p></div>
    <%% end %>

  </div>
</div>